{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whimbrel",
  "identifier": "dev.whimbrel.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whimbrel",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "An HTTP client whose collections are plain files in git",
    "longDescription": "Whimbrel is a desktop HTTP client: requests are TOML files you keep in git, secrets stay in the OS keychain, and OpenAPI documents import as collections. No account, no cloud.",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0REQ0QzlBNTVBRDE2QjQKUldTMEZxMVZta3pkUkRXbUhSR0I1RmFJcEVHUFZNSVMrS3ltUGI1TUF5U1Q4ZDJlbWpiNjRDN1YK",
      "endpoints": [
        "https://github.com/akyrey/whimbrel/releases/latest/download/latest.json"
      ]
    }
  }
}
